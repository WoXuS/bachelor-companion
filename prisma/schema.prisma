generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Participant {
  id        String   @id @default(cuid())
  name      String   @unique
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  balance   Int      @default(0)

  Transactions Transaction[]

  CounterpartyTxs Transaction[] @relation("TxCounterparty")

  TournamentParticipants TournamentParticipant[]

  TournamentTeamMember TournamentTeamMember[]
}

model Transaction {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  amount       Int
  reason       String
  createdAt    DateTime @default(now())
  balanceAfter Int?
  matchId      String?

  counterpartyId String?
  counterparty   Participant? @relation("TxCounterparty", fields: [counterpartyId], references: [id])
}

model Prize {
  id          String   @id @default(cuid())
  place       Int      @unique
  title       String
  imageUrl    String?
  description String?
  createdAt   DateTime @default(now())
}

model ShopItem {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  cost      Int
  category  String
  createdAt DateTime @default(now())
}

enum TournamentType {
  SOLO
  TEAM
}

model Tournament {
  id               String         @id @default(cuid())
  title            String
  type             TournamentType
  mainPrize        Int
  matchWinPrize    Int
  consolationPrize Int            @default(0)
  createdAt        DateTime       @default(now())

  participants TournamentParticipant[]
  teams        TournamentTeam[]
  matches      Match[]
}

model TournamentParticipant {
  id            String      @id @default(cuid())
  tournamentId  String
  participantId String
  tournament    Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, participantId])
}

model TournamentTeam {
  id           String                 @id @default(cuid())
  tournamentId String
  name         String
  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  members      TournamentTeamMember[]
}

model TournamentTeamMember {
  id            String         @id @default(cuid())
  teamId        String
  participantId String
  team          TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant   Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
}

enum BracketKind {
  WINNERS
  LOSERS
  GRAND_FINAL
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round        Int
  indexInRound Int

  participantAId      String?
  participantBId      String?
  winnerParticipantId String?

  teamAId      String?
  teamBId      String?
  winnerTeamId String?

  scoreA Int?
  scoreB Int?

  nextMatchId     String?
  nextMatch       Match?  @relation("NextMatch", fields: [nextMatchId], references: [id])
  previousMatches Match[] @relation("NextMatch")
  nextMatchSlot   String?

  bracket          BracketKind @default(WINNERS)
  loserNextMatchId String?
  loserNextMatch   Match?      @relation("LoserNext", fields: [loserNextMatchId], references: [id])
  loserPrevious    Match[]     @relation("LoserNext")

  isBye    Boolean @default(false)
  bestOf   Int     @default(1)
  isPlayIn Boolean @default(false)
}
