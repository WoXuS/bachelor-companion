# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/bachelor_companion"

# Password for the single shared admin account
ADMIN_PASSWORD="change-me"

# Key used to sign admin session cookies. At least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Pusher Channels credentials. Optional - without them the app works,
# but live "easter egg found" notifications are not delivered.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# Base URL embedded in printable easter egg QR codes
NEXT_PUBLIC_CANONICAL_BASE="http://localhost:3000"

# Public demo instance. When "true": the login page gets a passwordless admin
# button, a banner is shown, and POST /api/demo/reset is enabled.
# The reset DELETES ALL DATA - never enable this on a real instance.
DEMO_MODE="false"

# Bearer token required by POST /api/demo/reset. Generate with: openssl rand -hex 32
CRON_SECRET=""
